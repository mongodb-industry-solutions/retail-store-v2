# ─── Required ─────────────────────────────────────────────────────────────────
# These are needed to run the product enhancement pipeline (script.js)

# MongoDB connection string
MONGO_URI=""

# Target database and collection
DB_NAME=leafy_popup_store
COL_NAME=products

# Concurrency for LLM calls (Phase 1)
CONCURRENCY=5

# ─── Optional: Only needed if re-generating embeddings ────────────────────────
# Phase 2 generates vector embeddings via Voyage AI. If you restored the seed
# dump, products already have embeddings and Phase 2 will be skipped.

# Voyage AI API key (for embedding generation)
VOYAGE_AI_API_KEY=""

# Embedding model name
EMBEDDING_MODEL=voyage-4

# Batch size for Voyage AI embedding calls (Phase 2)
VOYAGE_BATCH_SIZE=20

# ─── Atlas Search index names ──────────────────────────────────────
# checkIndexes creates these indexes if they don't exist. The app's index warning
# banner can also create them automatically on first boot.

VECTOR_INDEX_NAME=vector_index
TEXT_INDEX_NAME=text_search_index


# ─── Optional: Only needed if re-generating product descriptions ──────────────
# microservices/productEmbeddings/script.js uses Anthropic Claude to generate AI descriptions,
# category assignments, and polymorphic attributes. If you restored the seed
# dump, products already have this data and Phase 1 will be skipped.

# Anthropic API key (for Claude Haiku description generation)
ANTHROPIC_API_KEY=""

# Haiku model name
HAIKU_MODEL=claude-haiku-4-5-20251001