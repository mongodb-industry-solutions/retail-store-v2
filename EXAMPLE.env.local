# ─── Required ─────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGODB_URI=
# Database name (default: leafy_popup_store)
DATABASE_NAME=leafy_popup_store
# Node environment
NODE_ENV=development

# ─── Search Configuration ─────────────────────────────────────────────────────

# Voyage AI API key — required for semantic (vector) search at runtime
# Get one free at https://ai.mongodb.com or https://dash.voyageai.com
VOYAGE_AI_API_KEY=

# Embedding model used to generate query embeddings (must match what was used for product embeddings)
VOYAGE_EMBEDDING_MODEL=voyage-4
# Voyage AI API URL (Atlas-hosted endpoint)
VOYAGE_API_URL=https://ai.mongodb.com/v1/embeddings

# Atlas Search index names (must match the indexes on your cluster)
VECTOR_INDEX_NAME=vector_index
TEXT_INDEX_NAME=text_search_index

# ─── Optional: AI Product Enrichment ──────────────────────────────────────────
# Used by the Amazon Product Importer (Chrome extension → /api/amazon/import)
# and the product enhancement pipeline (microservices/productEmbeddings/script.js)
# Without ANTHROPIC_API_KEY, imported products get basic data only (no AI descriptions)
# Without VOYAGE_AI_API_KEY, imported products won't have vector embeddings for search

# Anthropic API key — enables AI-generated descriptions, categories, and attributes
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# LLM model to use (default: claude-3-5-haiku-20241022)
# HAIKU_MODEL=claude-3-5-haiku-20241022

# Atlas Admin API keys (used for programmatic index creation in the generation script)
# API_PUBLIC_KEY=
# API_PRIVATE_KEY=
